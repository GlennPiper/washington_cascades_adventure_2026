<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="build_deliverables.py" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Washington Cascades Adventure Route Trip Plan</name><desc>Day-split tracks, POIs, and primary/backup campgrounds for the September 8-13, 2026 trip.</desc><time>2026-09-07T00:00:00Z</time></metadata>
<wpt lat="45.7083642" lon="-121.8266111"><name>DP - Columbia River Gorge</name><desc>Trip start. Only sea-level breach of the Cascade Range.</desc><sym>water</sym></wpt>
<wpt lat="45.758434" lon="-121.8372234"><name>DP - High Bridge</name><desc>Wind River Rd crossing high above the canyon.</desc><sym>bridge</sym></wpt>
<wpt lat="45.7593874" lon="-121.835913"><name>[BACKUP] DP - Wind River</name><desc>Same pullout as High Bridge.</desc><sym>water</sym></wpt>
<wpt lat="45.7855023" lon="-121.7365882"><name>[BACKUP] Triangle Pass</name><desc>Loop junction. The route returns through here at mi 324.8 on the final day.</desc><sym>attraction</sym></wpt>
<wpt lat="45.8532238" lon="-121.7203839"><name>DP - Big Lava Bed</name><desc>Rugged 8,200-year-old basalt flow from the Indian Heaven volcanic field.</desc><sym>volcano</sym></wpt>
<wpt lat="45.9249927" lon="-121.6629149"><name>[BACKUP] Monte Cristo Slab</name><desc>Rock-climbing crag ~1.9 mi off route.</desc><sym>cliff</sym></wpt>
<wpt lat="45.9412627" lon="-121.7636038"><name>DP - Goose Lake</name><desc>Lava-dammed lake; the Big Lava Bed flow created it.</desc><sym>lake</sym></wpt>
<wpt lat="45.97018294192685" lon="-121.65952920913696"><name>[BACKUP] Interpretive Site: Peterson Prairie</name><desc>~3.4 mi off route, next to Peterson Prairie Campground.</desc><sym>information</sym></wpt>
<wpt lat="45.961424" lon="-121.631396"><name>[HIKE] DP - Guler Ice Cave</name><desc>Developed 650-ft lava tube west of Trout Lake. $5 day-use / Northwest Forest Pass. Ladder entry; ice features are often gone by September. About 4.5 mi off route (9 mi round trip). Decontaminate kit before Falls Creek on Saturday.</desc><sym>cave</sym></wpt>
<wpt lat="45.9581497" lon="-121.7558541"><name>DP - Forlorn Lakes</name><desc>Chain of about a dozen small lakes at ~3,700 ft.</desc><sym>lake</sym></wpt>
<wpt lat="46.0538329" lon="-121.7504926"><name>Indian Viewpoint</name><desc>Roadside viewpoint on the Indian Heaven shoulder.</desc><sym>binoculars</sym></wpt>
<wpt lat="46.0881532" lon="-121.7678311"><name>DP - Berry Fields Interpretive Site</name><desc>Sawtooth Berry Fields - a tribal gathering place for over 9,000 years. Ripe huckleberries in September; the fields are reserved for tribal harvest in places, so read the posted signs.</desc><sym>attraction</sym></wpt>
<wpt lat="46.095372594088246" lon="-121.71658246202995"><name>DP - Basket Tree Interpretive Site</name><desc>Preserved cedar showing traditional bark harvesting.</desc><sym>attraction</sym></wpt>
<wpt lat="46.0985052" lon="-121.7186593"><name>[HIKE] DP - Langfield Falls</name><desc>Short, easy trail to the falls on Big Mosquito Creek. Good first stretch-the-legs stop.</desc><sym>waterfall</sym></wpt>
<wpt lat="46.1379788" lon="-121.7277398"><name>[HIKE] DP - Steamboat Mountain Lookout</name><desc>Former lookout site at 5,424 ft. Steep but short; big Cascades panorama.</desc><sym>binoculars</sym></wpt>
<wpt lat="46.1536338" lon="-121.6284801"><name>Mt Adams Viewpoint</name><desc>Roadside Mount Adams view.</desc><sym>binoculars</sym></wpt>
<wpt lat="46.1638419" lon="-121.6384314"><name>[BACKUP] Swampy Meadows</name><desc>Subalpine meadow, good wildlife stop.</desc><sym>marsh</sym></wpt>
<wpt lat="46.25534875800656" lon="-121.60873747043782"><name>[BACKUP] DP - Lewis River</name><desc>Headwaters draining Adams Glacier.</desc><sym>water</sym></wpt>
<wpt lat="46.2646371" lon="-121.6315627"><name>DP - Council Lake</name><desc>Small high lake at ~4,200 ft.</desc><sym>lake</sym></wpt>
<wpt lat="46.2716463" lon="-121.6379407"><name>[HIKE] DP - Council Bluff</name><desc>Short steep climb to a ~4,800 ft summit with a panoramic payoff. Historic council site.</desc><sym>cliff</sym></wpt>
<wpt lat="46.2681516" lon="-121.6046563"><name>DP - Babyshoe Pass</name><desc>~4,350 ft pass on FS 23. Gravel over the top.</desc><sym>attraction</sym></wpt>
<wpt lat="46.2782671" lon="-121.5963891"><name>DP - Takhlakh Lake</name><desc>The signature view of the route: Mount Adams reflected in the lake. Day 1 overnight is the free High Lakes cluster (Council, Olallie and nearby pullouts), not the paid campground.</desc><sym>lake</sym></wpt>
<wpt lat="46.2723377" lon="-121.5850195"><name>DP - Takh Takh Lava Flow</name><desc>Young basalt flow off Mount Adams, right beside Takhlakh Lake.</desc><sym>volcano</sym></wpt>
<wpt lat="46.3513268" lon="-121.5235939"><name>[BACKUP] Midway Warming Hut</name><desc>Simple non-reservable winter shelter; hub of the Midway trail network.</desc><sym>building-24</sym></wpt>
<wpt lat="46.338113" lon="-121.6478366"><name>DP - Cispus River</name><desc>Upper Cispus, fed from Snowgrass Flats in the Goat Rocks.</desc><sym>water</sym></wpt>
<wpt lat="46.3903281" lon="-121.6065591"><name>[HIKE] DP - Hamilton Buttes</name><desc>5,772 ft summit in the Dark Divide. Longer climb; big views.</desc><sym>peak</sym></wpt>
<wpt lat="46.4372196" lon="-121.6869999"><name>[HIKE] DP - Bishop Falls</name><desc>Hidden multi-tier falls in a steep, remote canyon. Access is rough - scout before committing.</desc><sym>waterfall</sym></wpt>
<wpt lat="46.4314153" lon="-121.4983625"><name>[HIKE] DP - Walupt Creek Falls</name><desc>Roughly 220-245 ft of tiered falls.</desc><sym>waterfall</sym></wpt>
<wpt lat="46.4167818" lon="-121.4638236"><name>DP - Walupt Lake</name><desc>Second-largest lake in the forest and the deepest in the county. Visit for the lake and Goat Rocks trailheads; Thursday night is Chambers Lake (free), with Walupt CG as the paid backup.</desc><sym>lake</sym></wpt>
<wpt lat="46.4811976" lon="-121.5152929"><name>[BACKUP] Goat Ridge Lookout</name><desc>~2.3 mi off route.</desc><sym>binoculars</sym></wpt>
<wpt lat="46.6844957" lon="-121.9013926"><name>[HIKE] DP - High Rock Lookout</name><desc>About 3 miles round trip to a historic lookout perched over a cliff, with Mount Rainier only 13 air miles away. The best view on the route and the single most worthwhile hike. Access road is rough; the last stretch is narrow.</desc><sym>fire-lookout</sym></wpt>
<wpt lat="46.5324678" lon="-121.9561945"><name>[BACKUP] DP - Cowlitz River</name><desc>Glacier-fed Cowlitz, alongside US 12.</desc><sym>water</sym></wpt>
<wpt lat="46.4601156" lon="-121.8604313"><name>Layser Cave</name><desc>Interpreted rock shelter above the Cispus valley and one of the most significant archaeological sites in the western Cascades. Short walk from the parking area.</desc><sym>cave</sym></wpt>
<wpt lat="46.4514302" lon="-121.8312832"><name>Camp Creek Falls</name><desc>Short roadside waterfall stop.</desc><sym>waterfall</sym></wpt>
<wpt lat="46.4073397" lon="-121.8658948"><name>DP - Burley Mountain Fire Lookout</name><desc>Historic lookout at 5,154 ft with a 360-degree view taking in Rainier, Adams, St Helens and Hood. Drivable to near the top; narrow road.</desc><sym>fire-lookout</sym></wpt>
<wpt lat="46.3266906" lon="-121.9236918"><name>DP - Pinto Rock</name><desc>Striking welded-tuff breccia crag at 5,123 ft.</desc><sym>cliff</sym></wpt>
<wpt lat="46.288818" lon="-121.96659"><name>Elk Pass</name><desc>High point on the route between the Cispus and Lewis drainages.</desc><sym>attraction</sym></wpt>
<wpt lat="46.0575512" lon="-121.975125"><name>[BACKUP] Miller Creek Falls</name><desc>Near the Curly Creek pullout.</desc><sym>waterfall</sym></wpt>
<wpt lat="46.0581617" lon="-121.9723141"><name>DP - Curly Creek Falls</name><desc>One of a tiny handful of waterfalls on earth with two natural basalt arches spanning its face. Short walk from the road.</desc><sym>waterfall</sym></wpt>
<wpt lat="46.0670247" lon="-121.9278136"><name>[BACKUP] Rush Creek Falls</name><desc>Same pullout area as Curly Creek Falls.</desc><sym>waterfall</sym></wpt>
<wpt lat="45.9447262" lon="-121.8680716"><name>[HIKE] DP - Falls Creek Lava Caves</name><desc>LAVA TUBE. No permit, no paid entry — this is not Ape Cave. A large cave system formed by the Big Lava Bed flow ~8,200 years ago. Every person going in needs their own headlamp plus a backup light and spare batteries; the cave is pitch dark, the floor is uneven basalt, and it stays cold year round. Boots, gloves and a helmet or beanie are worth having. Decontaminate kit first if you went in Guler Ice Cave on Wednesday. See the lava caves page for parking and how to find the pits.</desc><sym>cave</sym></wpt>
<wpt lat="45.9356072" lon="-121.821375"><name>[HIKE] Red Mountain Fire Lookout</name><desc>Lookout at 4,965 ft on the Indian Heaven boundary; panorama of four volcanoes. ~1.7 mi off route.</desc><sym>fire-lookout</sym></wpt>
<wpt lat="45.8671944" lon="-121.8288441"><name>DP - Panther Creek Falls</name><desc>About 130 ft of tiered falls with a built viewing platform a short walk from the road. First and last night are the free pullouts just up this road.</desc><sym>waterfall</sym></wpt>
<wpt lat="45.834828" lon="-121.870893"><name>[CAMP PRIMARY-A] Sep 8 (Tue) + Sep 12 (Sat) - Panther Creek Dispersed #2</name><desc>Free | Fire pit. No toilet, no water. Small-rig friendly. | Closest of the three named pullouts to the developed campground (~0.3 mi off the loop at mile 308, and the same road you drive Tuesday evening). Most reviewed of the cluster. Six vehicles will not share one pullout. Scout on arrival and take several adjacent existing sites in the same cluster. | Access: Panther Creek Rd (FS 65 / 6513) off Wind River Rd, north of the developed campground.</desc><sym>Campground</sym></wpt>
<wpt lat="45.84326" lon="-121.85922"><name>[CAMP PRIMARY-B] Sep 8 (Tue) + Sep 12 (Sat) - Panther Creek Dispersed #1</name><desc>Free | No amenities. One of several pullouts along Panther Creek. | About a mile further up the same road as #2. Use it when #2 is taken or to spread the group. Six vehicles will not share one pullout. Scout on arrival and take several adjacent existing sites in the same cluster. | Access: FS 65 / 6513, continuing north from the developed campground.</desc><sym>Campground</sym></wpt>
<wpt lat="45.84941" lon="-121.85544"><name>[CAMP PRIMARY-C] Sep 8 (Tue) + Sep 12 (Sat) - Upper Panther Creek Dispersed</name><desc>Free | Large, fairly flat grassy pullout with a fire ring. Unmaintained. | The roomiest of the three. Same arrival corridor Tuesday evening. Six vehicles will not share one pullout. Scout on arrival and take several adjacent existing sites in the same cluster. | Access: NF-6513 off Panther Creek Rd.</desc><sym>Campground</sym></wpt>
<wpt lat="45.81972" lon="-121.87972"><name>[CAMP BACKUP] Sep 8 (Tue) - Panther Creek Campground (Recreation.gov 233103)</name><desc>Per-site fee; 9 of 33 sites are first-come | Vault toilets, potable water, tables, fire rings. No hookups. | Paid backup. 19 of 33 sites showed available for Sep 8 as of 2026-08-31. Use it if the pullouts are full or you want water and a toilet after the drive from Nampa. | Access: WA-14 to Carson, north on Wind River Rd, right on Panther Creek Rd (FS 65).</desc><sym>Campground</sym></wpt>
<wpt lat="45.7087" lon="-121.77348"><name>[CAMP LAST-RESORT-A] Sep 8 (Tue) - Home Valley Campground (Skamania County park)</name><desc>County park fee | Showers, potable water, toilets - the only showers near the route. | Paid. Right on the Columbia and only 2.9 miles from route mile 0. Sits between WA-14 and the BNSF main line, so expect highway and train noise. | Access: Directly off WA-14 at Home Valley, east of Carson.</desc><sym>Campground</sym></wpt>
<wpt lat="45.79501" lon="-121.63444"><name>[CAMP LAST-RESORT-B] Sep 8 (Tue) - Moss Creek Campground</name><desc>Per-site fee | Vault toilets, water | Paid first-come on the Little White Salmon. Only if the group banks miles on arrival evening. | Access: FS 18 north from Willard.</desc><sym>Campground</sym></wpt>
<wpt lat="46.26327" lon="-121.63178"><name>[CAMP PRIMARY-A] Sep 9 (Wed) - Council Lake Campground</name><desc>Free or low fee | Vault toilet. No potable water. | On-route at mile 79.2, about 5 miles before Takhlakh. The best-documented free High Lakes camp. Small — not six rigs in one loop. Six vehicles will not share one pullout. Scout on arrival and take several adjacent existing sites in the same cluster. | Access: Short rough spur off FS 2334.</desc><sym>Campground</sym></wpt>
<wpt lat="46.28868" lon="-121.61949"><name>[CAMP PRIMARY-B] Sep 9 (Wed) - Olallie Lake Campground</name><desc>Free or low fee | Vault toilet. No potable water. | First-come. Very small, same Midway High Lakes cluster as Takhlakh. | Access: Spur off FS 2329.</desc><sym>Campground</sym></wpt>
<wpt lat="46.2931" lon="-121.59633"><name>[CAMP PRIMARY-C] Sep 9 (Wed) - Chain of Lakes Campground</name><desc>Free or low fee | Vault toilet. No potable water. | First-come, rough access road. Spillover for the High Lakes cluster. | Access: Rough spur off FS 2329.</desc><sym>Campground</sym></wpt>
<wpt lat="46.30978" lon="-121.56663"><name>[CAMP PRIMARY-D] Sep 9 (Wed) - Horseshoe Lake Campground</name><desc>Free or low fee | Vault toilet. No potable water. | First-come, just under a mile off route past Takhlakh. | Access: FS 2329 spur.</desc><sym>Campground</sym></wpt>
<wpt lat="46.350466" lon="-121.597704"><name>[CAMP PRIMARY-E] Sep 9 (Wed) - Orr Creek Sno-Park</name><desc>Free | Vault toilet (sun vault). No potable water. | On FS 23 at mile 96.6, about 12 route miles past Takhlakh toward Adams Fork. Push here only if High Lakes is slammed; it shortens Thursday. Elk sometimes pass through. Six vehicles will not share one pullout. Scout on arrival and take several adjacent existing sites in the same cluster. | Access: FS 23 north of Takhlakh / south of Adams Fork.</desc><sym>Campground</sym></wpt>
<wpt lat="45.91383" lon="-121.695408"><name>[CAMP BACKUP-A] Sep 9 (Wed) - Near Lava Beds</name><desc>Free | Informal pullouts near a pond on the way to Big Lava Bed. No facilities. | On-route at mile 30.8, Day 1 afternoon. Early-stop option, not the High Lakes night. 10 community reviews. | Access: Paved approach toward Big Lava Bed, ~45 min from the Columbia.</desc><sym>Campground</sym></wpt>
<wpt lat="45.924556" lon="-121.774469"><name>[CAMP BACKUP-B] Sep 9 (Wed) - Forest Route 60</name><desc>Free | Several pullouts along FS 60. No facilities. Some spots are tight for larger rigs. | On-route at mile 34.2 near Goose Lake / the lava-bed edge. Unrated listing. | Access: FS 60 through the Indian Heaven / lava-bed corridor.</desc><sym>Campground</sym></wpt>
<wpt lat="46.091105" lon="-121.79985"><name>[CAMP BACKUP-C] Sep 9 (Wed) - Huckleberry Access</name><desc>Free | Paved viewpoint with room for RVs. No toilet listed. | On-route at mile 54.5. Mount St Helens view and seasonal huckleberries. May be day-use — read posted signs before overnighting. | Access: FS 23 / berry-fields corridor.</desc><sym>Campground</sym></wpt>
<wpt lat="46.18798" lon="-121.82302"><name>[CAMP BACKUP-D] Sep 9 (Wed) - Forest Road 9705</name><desc>Free | Several pullouts past Lewis River Horse Camp with rock fire pits. Room for cars. Quiet road. No toilet listed. | About 4.7 miles off the track near mile 57, on the Lewis River side of Day 1. Early-stop / overflow, not the High Lakes night. | Access: Forest Road 9705 past the Lewis River Horse Camp.</desc><sym>Campground</sym></wpt>
<wpt lat="46.056878" lon="-121.628389"><name>[CAMP BACKUP-E] Sep 9 (Wed) - Flattop Sno-Park</name><desc>Free | Winter lot used as a free dispersed site in summer. No reviews on file. | About 3.3 miles off the track near mile 46. Unconfirmed; scout before committing. | Access: Trout Lake / FS 23 side roads.</desc><sym>Campground</sym></wpt>
<wpt lat="46.28083" lon="-121.59861"><name>[CAMP LAST-RESORT] Sep 9 (Wed) - Takhlakh Lake Campground (Recreation.gov 232861)</name><desc>Per-site fee; 18 of 54 sites are first-come | Vault toilets, potable water, tables, fire rings. No hookups. Non-motorised boating only. | Paid backup at the signature lake. 22 of 54 sites showed available for Sep 9 as of 2026-08-31; zero Friday and Saturday. Use it if the free High Lakes cluster is full or you want potable water. | Access: FS 23 over Babyshoe Pass, then FS 2329.</desc><sym>Campground</sym></wpt>
<wpt lat="46.46549" lon="-121.53183"><name>[CAMP PRIMARY-A] Sep 10 (Thu) - Chambers Lake Campground</name><desc>Free or low fee | Vault toilet. No potable water. | Free first-come camp at mile 140.5, about 8 miles past Walupt near the Goat Rocks boundary. The actual Thursday night. Availability cannot be checked in advance. Six vehicles will not share one pullout. Scout on arrival and take several adjacent existing sites in the same cluster. | Access: FS 21 spur north of the Walupt junction.</desc><sym>Campground</sym></wpt>
<wpt lat="46.34855" lon="-121.62496"><name>[CAMP PRIMARY-B] Sep 10 (Thu) - Cat Creek Campground</name><desc>Free | Vault toilet. No potable water. | First-come, very small, route mile 101. Early-stop option that shortens Thursday and lengthens Friday. Six vehicles will not share one pullout. Scout on arrival and take several adjacent existing sites in the same cluster. | Access: FS 2160 just east of Adams Fork.</desc><sym>Campground</sym></wpt>
<wpt lat="46.42306" lon="-121.47361"><name>[CAMP LAST-RESORT-A] Sep 10 (Thu) - Walupt Lake Campground (Recreation.gov 232860)</name><desc>Per-site fee; 14 of 42 sites are first-come | Vault toilets, potable water, boat launch. No hookups. | Paid backup at the lake itself. 7 of 42 sites showed available for Sep 10 as of 2026-08-31. Goat Rocks trailheads leave from the campground. The access road in is long and rough. | Access: FS 21 then FS 2160 east - roughly 16 miles of gravel off the main route.</desc><sym>Campground</sym></wpt>
<wpt lat="46.33889" lon="-121.64694"><name>[CAMP LAST-RESORT-B] Sep 10 (Thu) - Adams Fork Campground (Recreation.gov 232857)</name><desc>Per-site fee; 7 of 23 sites are first-come | Vault toilets, tables, fire rings. No potable water. | Paid early-stop at mile 99.6. 16 of 23 sites showed available for Sep 10. Choosing it shortens Thursday and lengthens Friday. | Access: On FS 21 beside the Cispus River.</desc><sym>Campground</sym></wpt>
<wpt lat="46.433576" lon="-121.940737"><name>[CAMP PRIMARY] Sep 11 (Fri) - Greenhorn Creek</name><desc>Free | Three shaded creek sites. No toilet listed. Spots can fit a ~24 ft rig. | On the FS 25 side of the Cispus at mile 230.8, a few miles past North Fork / Tower Rock. Best genuine dispersed night for Friday. Six vehicles will not share one pullout. Scout on arrival and take several adjacent existing sites in the same cluster. | Access: South of Randle on FS 25 / Greenhorn Creek.</desc><sym>Campground</sym></wpt>
<wpt lat="46.63837" lon="-121.71165"><name>[CAMP BACKUP-A] Sep 11 (Fri) - Skate Creek Sno-Park</name><desc>Free | Pull-offs along the road; most have a fire pit. River sites exist. | On-route at mile 160.7 near Packwood. Early-stop / overflow, not the Friday night unless the day is running long. | Access: Skate Creek Rd (FS 52) near Packwood.</desc><sym>Campground</sym></wpt>
<wpt lat="46.63448" lon="-121.679917"><name>[CAMP BACKUP-B] Sep 11 (Fri) - Packwood WA NF</name><desc>Free | End-of-road site in an old quarry. No facilities. | On-route at mile 158.6. Same Packwood-area overflow idea as Skate Creek. | Access: National forest road at the edge of Packwood.</desc><sym>Campground</sym></wpt>
<wpt lat="46.427984" lon="-121.98043"><name>[CAMP BACKUP-C] Sep 11 (Fri) - Iron Creek Dispersed</name><desc>Free | Pullouts about 1/4 mile past the official Iron Creek campground. | The developed Iron Creek campground is CLOSED the entire trip week. These pullouts may still be open — or may be wrapped into the closure. Confirm with Cowlitz Valley Ranger District before counting on it. | Access: FS 25 toward Mt St Helens, past the closed Iron Creek campground.</desc><sym>Campground</sym></wpt>
<wpt lat="46.4525" lon="-121.78889"><name>[CAMP LAST-RESORT-A] Sep 11 (Fri) - North Fork Elk Group Camp (Recreation.gov 232898)</name><desc>Single group-site fee for the whole party | Vault toilets, potable water, group shelter area, tables, fire rings. | Paid backup that actually fits six vehicles in one booking. As of 2026-08-31 it was open Fri Sep 11 and Sat Sep 12. Worth considering if the group wants to stay together with water and a shelter. | Access: FS 23 south from Randle along the Cispus, near North Fork Campground.</desc><sym>Campground</sym></wpt>
<wpt lat="46.445" lon="-121.86806"><name>[CAMP LAST-RESORT-B] Sep 11 (Fri) - Tower Rock Campground (Recreation.gov 232855)</name><desc>Per-site fee; 6 of 20 sites are first-come | Vault toilets, potable water, tables, fire rings. | Paid backup at mile 228.6. Best weekend availability found on the paid list: 10 of 20 Friday, 8 Saturday as of 2026-08-31. | Access: FS 23 / FS 28 along the Cispus, south of Randle.</desc><sym>Campground</sym></wpt>
<wpt lat="45.90889" lon="-121.80103"><name>[CAMP PRIMARY-D] Sep 12 (Sat) - Crest Camp</name><desc>Free | None. No water, no toilet. | Primitive site at mile 302.7 near the PCT crossing. Fits a couple of rigs. Earlier Saturday stop if Panther Creek pullouts are full. | Access: FS 60 near the PCT trailhead.</desc><sym>Campground</sym></wpt>
<wpt lat="46.336418" lon="-121.967987"><name>[CAMP BACKUP-A] Sep 12 (Sat) - FR-7708</name><desc>Free | Creek-side site with a cold pool. No facilities. | On-route at mile 244.5, Saturday morning after Greenhorn / Iron Creek. | Access: Gifford Pinchot, FS 7708 off the Cispus / Lewis divide.</desc><sym>Campground</sym></wpt>
<wpt lat="46.110056" lon="-121.99432"><name>[CAMP BACKUP-B] Sep 12 (Sat) - Forest Route 9039</name><desc>Free | Several tucked sites. A couple will take a trailer. No facilities. | On-route at mile 272, Lewis River / Cougar side. Hunting-area notes in reviews. Early Saturday stop that leaves loop miles for Sunday. | Access: FS 9039 off the Lewis River corridor.</desc><sym>Campground</sym></wpt>
<wpt lat="46.125331" lon="-121.909858"><name>[CAMP BACKUP-C] Sep 12 (Sat) - Dispersed campsite off NF-90</name><desc>Free | Dispersed site off NF-90. Confirm the area is open before leaving cell service. | On-route at mile 281.6 on the Lewis River. Same early-stop idea as FS 9039. | Access: NF-90, Gifford Pinchot.</desc><sym>Campground</sym></wpt>
<wpt lat="46.044029" lon="-121.859371"><name>[CAMP BACKUP-D] Sep 12 (Sat) - Lone Butte Sno-Park</name><desc>Free | Winter lot; free dispersed in summer. Unrated. | On-route at mile 288.1, Wind River high country approaching Panther Creek. | Access: FS 30 / 60 corridor west of Indian Heaven.</desc><sym>Campground</sym></wpt>
<wpt lat="46.035354" lon="-121.880896"><name>[CAMP BACKUP-E] Sep 12 (Sat) - Rush Creek Sno-Park</name><desc>Free | Winter lot; free dispersed in summer. Unrated. | On-route at mile 289.4, same corridor as Lone Butte and Curley Creek. | Access: FS 30 / 60 corridor.</desc><sym>Campground</sym></wpt>
<wpt lat="46.026705" lon="-121.891036"><name>[CAMP BACKUP-F] Sep 12 (Sat) - Curley Creek Sno-Park</name><desc>Free | Winter lot; free dispersed in summer. Unrated. | On-route at mile 289.6. Third of the three sno-park pullouts in this cluster. | Access: FS 30 / 60 corridor.</desc><sym>Campground</sym></wpt>
<wpt lat="45.81972" lon="-121.87972"><name>[CAMP LAST-RESORT-A] Sep 12 (Sat) - Panther Creek Campground (Recreation.gov 233103)</name><desc>Per-site fee; 9 of 33 sites are first-come | Vault toilets, potable water, tables, fire rings. | Paid backup. Only 5 of 33 sites showed available for Sat Sep 12 as of 2026-08-31. Use it if the pullouts are full or you want water. | Access: Panther Creek Rd (FS 65) off Wind River Rd.</desc><sym>Campground</sym></wpt>
<wpt lat="45.7087" lon="-121.77348"><name>[CAMP LAST-RESORT-B] Sep 12 (Sat) - Home Valley Campground (Skamania County park)</name><desc>County park fee | Showers, potable water, toilets. | Paid. Finishing the full loop to Triangle Pass and dropping here makes Saturday longer but buys hot showers before the drive home. | Access: Directly off WA-14 at Home Valley.</desc><sym>Campground</sym></wpt>
<trk><name>Sep 8 (Tue) - Travel to the Gorge</name><trkseg>
